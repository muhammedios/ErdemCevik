# Sunucuda .env olarak oluşturun. Yerel .env dosyasını yayınlamayın.
APP_NAME="Diş Hekimi Erdem Çevik"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dterdemcevik.com
SITE_URL=https://dterdemcevik.com
SEO_INDEXABLE=true
# Search Console HTML etiketiyle doğrulama seçilirse yalnızca content değerini girin.
GOOGLE_SITE_VERIFICATION=

LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# Hosting hesabındaki gerçek, public/ DIŞINDAKİ mutlak yolu yazın.
DB_DATABASE=/absolute/path/to/database/database.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
